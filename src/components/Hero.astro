---
import { GITHUB_URL, LICENSE, PROJECT } from "../consts";
---

<header class="relative overflow-hidden border-b border-neutral-900">
  <!-- brilho sutil de fundo -->
  <div
    class="pointer-events-none absolute inset-0 opacity-60"
    style="background: radial-gradient(60rem 30rem at 50% -10%, rgba(45,184,158,0.12), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-4xl px-6 py-24 sm:py-32">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-emerald/30 bg-emerald/10 px-3 py-1 text-xs font-medium text-emerald"
      >
        Projeto IA.med
      </span>
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-neutral-800 bg-ink-800 px-3 py-1 text-xs font-medium text-neutral-400"
      >
        Licença {LICENSE}
      </span>
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-emerald/30 bg-emerald/10 px-3 py-1 text-xs font-medium text-emerald"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4z" />
        </svg>
        Conector ou local
      </span>
    </div>

    <h1 class="mt-6 font-mono text-4xl font-bold tracking-tight text-white sm:text-6xl">
      {PROJECT}
    </h1>

    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-300 sm:text-xl">
      Servidor MCP somente leitura da base do IA.med: o que saiu de IA na medicina
      em artigos, news, podcasts, aulas, eventos, conferências e repositórios, cada
      item com o link no app e a fonte original para citar. Três ferramentas, nenhum
      LLM no servidor. Use pelo conector hospedado, sem instalar nada, ou rode na sua
      máquina.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-emerald px-5 py-3 text-sm font-semibold text-ink-900 transition-colors hover:bg-emerald-400"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z" />
        </svg>
        Ver no GitHub
      </a>
      <a
        href="#conector"
        class="inline-flex items-center gap-2 rounded-lg border border-emerald/40 px-5 py-3 text-sm font-semibold text-emerald transition-colors hover:border-emerald hover:bg-emerald/10"
      >
        Usar o conector
      </a>
      <a
        href="#como-funciona"
        class="inline-flex items-center gap-2 rounded-lg border border-neutral-700 px-5 py-3 text-sm font-semibold text-neutral-200 transition-colors hover:border-emerald hover:text-emerald"
      >
        Como funciona
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </a>
    </div>
  </div>
</header>
