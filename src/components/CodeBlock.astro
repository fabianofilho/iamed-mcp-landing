---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: string;
  caption?: string;
}

const { code, lang = "bash", caption } = Astro.props;
---

<figure class="group relative overflow-hidden rounded-xl border border-neutral-800 bg-[#0d0d0d]">
  <button
    class="copy-btn absolute right-2 top-2 z-10 rounded-md border border-neutral-700 bg-ink-800/90 px-2.5 py-1 text-xs font-medium text-neutral-300 opacity-0 transition-opacity hover:border-emerald hover:text-emerald focus-visible:opacity-100 group-hover:opacity-100"
    data-code={code}
    type="button"
    aria-label="Copiar código"
  >
    Copiar
  </button>
  <div class="overflow-x-auto p-4 text-sm [&_pre]:!bg-transparent">
    <Code code={code} lang={lang} theme="github-dark" />
  </div>
  {
    caption && (
      <figcaption class="border-t border-neutral-800 px-4 py-2 text-xs text-neutral-500">
        {caption}
      </figcaption>
    )
  }
</figure>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy-btn")) {
    btn.addEventListener("click", async () => {
      const code = btn.dataset.code ?? "";
      try {
        await navigator.clipboard.writeText(code);
        const original = btn.textContent;
        btn.textContent = "Copiado";
        setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      } catch {
        /* clipboard indisponivel: nao faz nada */
      }
    });
  }
</script>
